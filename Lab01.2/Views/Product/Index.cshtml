@model IEnumerable<Product>
@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

<h3 class="mt-4 mb-3">Quản lý sản phẩm</h3>

<table class="table align-middle">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Price</th>
            <th>Created At</th>
            <th>Image</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Price.ToString("N0", new System.Globalization.CultureInfo("vi-VN")) đ</td>
                <td>@item.CreatedAt.ToString("dd-MM-yyyy")</td>
                <td><img src="~/images/@item.Image" alt="@item.Name" style="width:40px;height:40px" /></td>
                <td class="text-end"><a href="#" class="btn btn-success btn-sm">View</a></td>
            </tr>
        }
    </tbody>
</table>
