@model Product
@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<h3 class="mb-3">Chi tiết sản phẩm</h3>
<div class="row">
    <div class="col-md-4">
        @if (!string.IsNullOrEmpty(Model.Image))
        {
            <img src="~/products/@Model.Image" alt="@Model.Name" class="img-fluid border" />
        }
    </div>
    <div class="col-md-8">
        <dl class="row">
            <dt class="col-sm-3">ID</dt><dd class="col-sm-9">@Model.Id</dd>
            <dt class="col-sm-3">Tên sản phẩm</dt><dd class="col-sm-9">@Model.Name</dd>
            <dt class="col-sm-3">Danh mục</dt><dd class="col-sm-9">@ViewBag.CategoryName</dd>
            <dt class="col-sm-3">Giá</dt><dd class="col-sm-9">@Format.Money(Model.Price)</dd>
            <dt class="col-sm-3">Giá khuyến mãi</dt><dd class="col-sm-9">@Format.Money(Model.SalePrice)</dd>
            <dt class="col-sm-3">Mô tả</dt><dd class="col-sm-9" style="white-space:pre-line">@Model.Description</dd>
        </dl>
        <a class="btn btn-warning" asp-action="Edit" asp-route-id="@Model.Id">Sửa</a>
        <a class="btn btn-secondary" asp-action="Index">Về danh sách</a>
    </div>
</div>
