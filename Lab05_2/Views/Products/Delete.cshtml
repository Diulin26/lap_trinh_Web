@model Product
@{
    ViewData["Title"] = "Xóa sản phẩm";
}

<h3 class="mb-3">Xóa sản phẩm</h3>
<div class="alert alert-warning">Bạn có chắc chắn muốn xóa sản phẩm này không? Thao tác không thể hoàn tác.</div>

<div class="row">
    <div class="col-md-4">
        @if (!string.IsNullOrEmpty(Model.Image))
        {
            <img src="~/products/@Model.Image" alt="@Model.Name" class="img-fluid border" />
        }
    </div>
    <div class="col-md-8">
        <dl class="row">
            <dt class="col-sm-3">Tên sản phẩm</dt><dd class="col-sm-9">@Model.Name</dd>
            <dt class="col-sm-3">Danh mục</dt><dd class="col-sm-9">@ViewBag.CategoryName</dd>
            <dt class="col-sm-3">Giá</dt><dd class="col-sm-9">@Format.Money(Model.Price)</dd>
            <dt class="col-sm-3">Giá khuyến mãi</dt><dd class="col-sm-9">@Format.Money(Model.SalePrice)</dd>
        </dl>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
            <a class="btn btn-secondary" asp-action="Index">Hủy</a>
        </form>
    </div>
</div>
