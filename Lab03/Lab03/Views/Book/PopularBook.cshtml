@model IEnumerable<Lab03.Models.Book>
@foreach (var item in Model)
{
    <div class="col-xs-3 col-sm-3 col-md-3 col-lg-3">
        <div class="thumbnail" style="border: 1px solid #ddd; border-radius: 4px; padding: 5px; margin-bottom: 20px;">
            <img src="@item.Image" alt="@item.Title" style="width: 100%; height: 250px; object-fit: cover; display: block;">
            <div class="caption" style="text-align: center;">
                <h3 style="font-size: 16px; font-weight: bold; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@item.Title">@item.Title</h3>
                <p style="color: #d9534f; font-weight: bold;">
                    Price: @item.Price.ToString("N0") đ
                </p>
            </div>
        </div>
    </div>
}