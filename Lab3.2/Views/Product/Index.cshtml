@model List<Product>
@{
    ViewData["Title"] = "Sản phẩm";
    var categories = (List<Category>)ViewBag.Categories;
    int? currentId = (int?)ViewBag.CurrentCategoryId;
}

<div class="row mt-3">
    <div class="col-md-2">
        <h5>DANH MỤC</h5>
        <div class="list-group list-group-flush border">
            @foreach (var c in categories)
            {
                <a class="list-group-item list-group-item-action small @(currentId == c.Id ? "active" : "")"
                   asp-controller="Product" asp-action="Index" asp-route-categoryId="@c.Id">@c.Name</a>
            }
        </div>
    </div>

    <div class="col-md-10">
        <h4 class="mb-3">Danh sách sản phẩm</h4>
        @if (!Model.Any())
        {
            <p class="text-muted">Chưa có sản phẩm nào trong danh mục này.</p>
        }
        <div class="row">
            @foreach (var p in Model)
            {
                <div class="col-12 col-sm-6 col-lg-4 mb-3">
                    <div class="card h-100">
                        <img src="~/images/@p.Image" class="card-img-top" alt="@p.Name" />
                        <div class="card-body">
                            <h6 class="card-title">@p.Name</h6>
                            <p class="small mb-2"><del>Giá: @p.Price.ToString("0")</del> Giá: @p.SalePrice.ToString("0")</p>
                            <a class="btn btn-success btn-sm w-100" asp-controller="Product" asp-action="Detail" asp-route-id="@p.Id">Chi tiết</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
