@model IEnumerable<TaiSan>

<div class="section-head">
    <h3>@ViewBag.TieuDe</h3>
    <a href="#">Xem tất cả &rsaquo;</a>
</div>
<div class="grid">
    @foreach (var t in Model)
    {
        <div class="asset-card">
            <a href="#"><img src="~/images/@t.Anh" alt="" /></a>
            <h2>@t.TenTs</h2>
            <div class="asset-foot">
                <span class="price">@(t.NguyenGia == null ? "Chưa định giá" : t.NguyenGia.Value.ToString("0") + " tr")</span>
                <a asp-controller="Home" asp-action="Edit" asp-route-id="@t.MaTs" class="btn-buy" style="display:inline-block">Sửa</a>
            </div>
        </div>
    }
</div>
