@model Product
@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<h3 class="mt-3 mb-3">Chi tiết sản phẩm</h3>
<div class="row">
    <div class="col-md-4">
        <img src="~/images/@Model.Image" class="img-fluid" alt="@Model.Name" />
    </div>
    <div class="col-md-8">
        <h4>Sản phẩm: @Model.Name</h4>
        <p class="fs-5"><del>Giá gốc: @Model.Price.ToString("0")</del> Giá mới @Model.SalePrice.ToString("0")</p>
        <h5>Mô Tả:</h5>
        <p class="small">@Model.Description</p>
        <p class="fs-5">Trạng thái: @(Model.Status ? "Còn hàng" : "Hết hàng")</p>
        <p class="fs-5">Ngày đăng: @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</p>
        <hr />
        <a class="btn btn-danger btn-sm" asp-controller="Product" asp-action="Index" asp-route-categoryId="@Model.CategoryId">Về danh sách</a>
    </div>
</div>
