@model List<Category>

<div class="panel-box">
    <div class="panel-head">Danh mục sản phẩm</div>
    <div class="list-group list-group-flush">
        @foreach (var c in Model)
        {
            <a href="#" class="list-group-item list-group-item-action small py-2">@c.Name</a>
        }
    </div>
</div>
