<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DEMO LAB</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-expand navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">DEMO LAB</a>
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "About" ? "active" : "")" asp-controller="Home" asp-action="About">Giới thiệu</a></li>
                <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Contact" ? "active" : "")" asp-controller="Home" asp-action="Contact">Liên hệ</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Sản phẩm</a></li>
            </ul>
        </div>
    </nav>

    <div class="container mt-3">
        <div class="row">
            <!-- Cot trai: danh muc (partial view) + banner -->
            <div class="col-md-3">
                @await Html.PartialAsync("_CategoryPartial", SampleData.GetCategories())
                <img src="~/images/banner.svg" class="img-fluid mt-3 w-100" alt="Banner" />
            </div>

            <!-- Cot phai: noi dung tung trang -->
            <div class="col-md-9">
                @RenderBody()
            </div>
        </div>
    </div>

    <footer class="site-footer mt-4 py-4">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <h5>GIỚI THIỆU</h5>
                    <p class="small">Lorem ipsum dolor sit amet, consectetur adipisicing elit. Debitis ab suscipit deserunt mollitia reiciendis, nobis iure aliquam velit et laboriosam ducimus veritatis corporis est, dolores aperiam! Officiis impedit provident laboriosam.</p>
                </div>
                <div class="col-md-6">
                    <h5>LIÊN HỆ</h5>
                    <p class="small">Lorem ipsum dolor sit amet, consectetur adipisicing elit. Odit amet quidem impedit magni molestias. Dolores, aliquid commodi ut esse eos voluptatem nisi facilis dolorem, repudiandae culpa ea quidem.</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
