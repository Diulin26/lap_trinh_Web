@inject QLTaiSanContext db
@{
    var dsLoai = db.LoaiTaiSans.ToList();
}
<header class="header">
    <span>Xin chào, Quản trị viên &nbsp;|&nbsp; Đăng xuất &nbsp;|&nbsp; <a asp-controller="Home" asp-action="Create">Thêm tài sản</a></span>
        <div class="container">
            <span>Phòng Hành chính - Quản trị: <b>(024) 3999 8888</b> &nbsp;|&nbsp; Hỗ trợ: taisan@assethub.vn</span>
            <span>Xin chào, Quản trị viên &nbsp;|&nbsp; Đăng xuất</span>
        </div>
    <div class="header-main">
        <div class="container">
            <a asp-controller="Home" asp-action="Index"><img src="~/images/logo.png" alt="AssetHub" /></a>
            <div class="cart-box">Tổng tài sản: 16 - Nguyên giá: 3.125 triệu</div>
        </div>
    </div>
    <nav class="navbar">
        <div class="container">
            <ul class="menu">
                <li class="active"><a asp-controller="Home" asp-action="Index">Lê Thị Diệu Linh</a></li>
                @foreach (var loai in dsLoai)
                {
                    <li>
                        <a href="#" class="menu-loai"
                           data-url="@Url.Action("TaiSanTheoLoai", "Home", new { maLoai = loai.MaLoai })">@loai.TenLoai</a>
                    </li>
                }
            </ul>
            <form class="search-box">
                <input type="text" placeholder="Tìm tài sản..." />
                <button type="button">Tìm</button>
            </form>
        </div>
    </nav>
</header>
