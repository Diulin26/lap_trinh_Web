@model IEnumerable<Learner>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Mã</th>
            <th>Tên</th>
            <th>Họ</th>
            <th>Ngành</th>
            <th>Ngày Nhập Học</th>
            <th>Chức năng</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.LearnerID</td>
                <td>@s.FirstMidName</td>
                <td>@s.LastName</td>
                <td>@s.Major?.MajorName</td>
                <td>@s.EnrollmentDate</td>
                <td>
                    <a asp-action="Edit" asp-controller="Learner" asp-route-id="@s.LearnerID">Edit</a>|
                    <a asp-action="Delete" asp-controller="Learner" asp-route-id="@s.LearnerID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Thanh nav-phân trang: mid và keyword được ghi lại trên từng page-item -->
<ul class="pagination">
    @for (int i = 1; i <= (int)(ViewBag.pageNum ?? 0); i++)
    {
        <li class="page-item" page="@i"
            @(ViewBag.mid != null ? Html.Raw("mid=\"" + ViewBag.mid + "\"") : null)
            @(ViewBag.keyword != null ? Html.Raw("keyword=\"" + System.Net.WebUtility.HtmlEncode((string)ViewBag.keyword) + "\"") : null)>
            <a class="page-link">@i</a>
        </li>
    }
</ul>
