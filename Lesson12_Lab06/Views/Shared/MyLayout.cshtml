<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Management System</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <style>
        .sidebar { background:#212529; min-height:100vh; width:220px; color:#adb5bd; }
        .sidebar .title { font-size:.7rem; text-transform:uppercase; padding:1rem 1rem .25rem; }
        .sidebar a { color:#dee2e6; text-decoration:none; display:block; padding:.5rem 1rem; }
        .sidebar a:hover { background:#343a40; }
        .nav-item, .page-item { cursor:pointer; }
    </style>
</head>
<body>
    <nav class="navbar navbar-dark bg-dark px-3">
        <a class="navbar-brand" href="/">Management System</a>
    </nav>
    <div class="d-flex">
        <div class="sidebar">
            <div class="title">Core</div>
            <a href="/"><i class="fas fa-gauge me-2"></i>Dashboard</a>
            <div class="title">Addons</div>
            <a asp-controller="Learner" asp-action="Index"><i class="fas fa-chart-bar me-2"></i>Learners</a>
        </div>
        <div class="flex-grow-1">
            <main>
                @RenderBody()
            </main>
            <footer class="py-4 bg-light mt-auto text-center text-muted">
                &copy; MyWebApp
            </footer>
        </div>
    </div>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
